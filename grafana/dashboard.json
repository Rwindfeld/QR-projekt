    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#B877D9", "mode": "fixed" }, "unit": "ms" } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 36 },
