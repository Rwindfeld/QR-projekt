      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [{
        "rawSql": "SELECT $__timeGroupAlias(scanned_at,'1d'), ROUND(AVG(server_duration_ms))::bigint AS \"Server ms\", ROUND(AVG(client_load_ms))::bigint AS \"Klient ms\" FROM scans WHERE $__timeFilter(scanned_at) AND server_duration_ms IS NOT NULL GROUP BY 1 ORDER BY 1",
