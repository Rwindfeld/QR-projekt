      "targets": [{
        "rawSql": "SELECT PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY server_duration_ms)::bigint AS value FROM scans WHERE $__timeFilter(scanned_at) AND server_duration_ms IS NOT NULL",
