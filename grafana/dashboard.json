      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 3 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT ROUND(100.0 * COUNT(DISTINCT s.game_id) / NULLIF((SELECT COUNT(*)::numeric FROM games), 0), 1) AS value FROM scans s WHERE $__timeFilter(s.scanned_at)",
        "format": "table",
        "refId": "A"
      }],
      "title": "Andel af kataloget i brug",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Klik på tallet for fuld liste (0–${max_lav_scans} scanninger)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#E02F44" },
          "links": [{
            "title": "Se spil med lave scanninger",
            "url": "/d/${__dashboard.uid}/${__dashboard.slug}?${__url_time_range}&viewPanel=7&var-max_lav_scans=${max_lav_scans}",
            "targetBlank": false
          }]
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 3 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "rawSql": "SELECT COUNT(*)::bigint AS value FROM games g LEFT JOIN (SELECT s.game_id, COUNT(*)::bigint AS scans FROM scans s WHERE $__timeFilter(s.scanned_at) GROUP BY s.game_id) cnt ON cnt.game_id = g.id WHERE COALESCE(cnt.scans, 0) <= ${max_lav_scans}",
        "format": "table",
        "refId": "A"
      }],
      "title": "Spil med lave scanninger (≤ ${max_lav_scans})",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Klik på en søjle for at åbne spillets QR-side (ny fane)",
      "fieldConfig": {
        "defaults": {
          "links": [{
            "title": "Åbn spil-side (QR)",
            "url": "https://qr-spilcafe.onrender.com/scan/${__data.fields[\"slug\"]}",
            "targetBlank": true
          }]
        }
      },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 7 },
      "id": 5,
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0, "legend": { "displayMode": "list" } },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "slug": true }, "indexByName": {}, "renameByName": {} } }
      ],
      "targets": [{
        "rawSql": "SELECT g.name AS name, g.slug AS slug, COUNT(*)::bigint AS scans FROM scans s JOIN games g ON g.id = s.game_id WHERE $__timeFilter(s.scanned_at) GROUP BY g.id, g.name, g.slug ORDER BY scans DESC LIMIT 15",
        "format": "table",
        "refId": "A"
      }],
      "title": "Top 15 — højest efterspørgsel (køb/flere eksemplarer)",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 7 },
      "id": 6,
      "targets": [{
        "rawSql": "SELECT $__timeGroupAlias(scanned_at,'1d'), COUNT(*)::bigint AS value FROM scans WHERE $__timeFilter(scanned_at) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }],
      "title": "Scanninger pr. dag (trend)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Klik på Slug for at åbne spillets QR-side",
      "fieldConfig": {
        "overrides": [{
          "matcher": { "id": "byName", "options": "Slug" },
          "properties": [{
            "id": "links",
            "value": [{
              "title": "Åbn QR-side",
              "url": "https://qr-spilcafe.onrender.com/scan/${__value.raw}",
              "targetBlank": true
            }]
          }]
        }]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "targets": [{
        "rawSql": "SELECT g.name AS \"Spil\", g.slug AS \"Slug\", COALESCE(g.year_published::text, '—') AS \"År\", COALESCE(cnt.scans, 0)::bigint AS \"Scanninger\" FROM games g LEFT JOIN (SELECT s.game_id, COUNT(*)::bigint AS scans FROM scans s WHERE $__timeFilter(s.scanned_at) GROUP BY s.game_id) cnt ON cnt.game_id = g.id WHERE COALESCE(cnt.scans, 0) <= ${max_lav_scans} ORDER BY COALESCE(cnt.scans, 0) ASC, g.name",
        "format": "table",
        "refId": "A"
      }],
      "title": "Spil med lave scanninger - Overvej udskiftning",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Klik på Slug for at åbne spillets QR-side",
      "fieldConfig": {
        "overrides": [{
          "matcher": { "id": "byName", "options": "Slug" },
          "properties": [{
            "id": "links",
            "value": [{
              "title": "Åbn QR-side",
              "url": "https://qr-spilcafe.onrender.com/scan/${__value.raw}",
              "targetBlank": true
            }]
          }]
        }]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "targets": [{
        "rawSql": "SELECT s.scanned_at AS \"Tidspunkt\", g.name AS \"Spil\", g.slug AS \"Slug\" FROM scans s JOIN games g ON g.id = s.game_id WHERE $__timeFilter(s.scanned_at) ORDER BY s.scanned_at DESC LIMIT 50",
        "format": "table",
        "refId": "A"
      }],
      "title": "Seneste 50 scanninger",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Antal scanninger fordelt på ugedag (dansk tid, mandag foerst)",
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FF8C42" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list" },
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "format": "table",
        "rawSql": "WITH t AS (SELECT EXTRACT(ISODOW FROM scanned_at AT TIME ZONE 'Europe/Copenhagen')::int AS dow FROM scans WHERE $__timeFilter(scanned_at)) SELECT CASE dow WHEN 1 THEN 'Mandag' WHEN 2 THEN 'Tirsdag' WHEN 3 THEN 'Onsdag' WHEN 4 THEN 'Torsdag' WHEN 5 THEN 'Fredag' WHEN 6 THEN 'Loerdag' WHEN 7 THEN 'Soendag' END AS name, COUNT(*)::bigint AS scans FROM t GROUP BY dow ORDER BY dow",
        "refId": "A"
      }],
      "title": "Hvornår tages spil fra hylden — per ugedag",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "description": "Antal scanninger fordelt på tidspunkt (dansk tid)",
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FFB347" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list" },
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0
      },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
        "format": "table",
        "rawSql": "WITH t AS (SELECT EXTRACT(HOUR FROM scanned_at AT TIME ZONE 'Europe/Copenhagen')::int AS h FROM scans WHERE $__timeFilter(scanned_at)), b AS (SELECT CASE WHEN h BETWEEN 10 AND 13 THEN 1 WHEN h BETWEEN 14 AND 16 THEN 2 WHEN h BETWEEN 17 AND 21 THEN 3 WHEN h < 10 THEN 4 ELSE 5 END AS s, CASE WHEN h BETWEEN 10 AND 13 THEN '10-14 Formiddag' WHEN h BETWEEN 14 AND 16 THEN '14-17 Eftermiddag' WHEN h BETWEEN 17 AND 21 THEN '17-22 Aften' WHEN h < 10 THEN 'Foer aabning' ELSE 'Sent / andet' END AS name FROM t) SELECT name, COUNT(*)::bigint AS scans FROM b GROUP BY s, name ORDER BY s",
        "refId": "A"
      }],
      "title": "Hvornår tages spil fra hylden — per tid på dagen",
      "type": "barchart"
    },
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 34 },
      "id": 20,
      "options": {
        "content": "**Ydeevne — hvad måles?**\n- **Server ms:** tid fra scan-request til HTML er klar (inkl. database).\n- **DB ms:** tid til at gemme scan i Postgres.\n- **Klient ms:** tid i gæstens browser (QR → færdig tak-side). Sendes automatisk efter load.\n- **Grafana:** data er i Postgres med det samme; dashboard opdateres ca. hvert 30. sek.",
        "mode": "markdown"
      },
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#5794F2", "mode": "fixed" }, "unit": "ms" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 36 },
