    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 26,
      "targets": [{
        "rawSql": "SELECT s.scanned_at AS \"Tidspunkt\", g.name AS \"Spil\", s.server_duration_ms AS \"Server ms\", s.db_duration_ms AS \"DB ms\", s.client_load_ms AS \"Klient ms\" FROM scans s JOIN games g ON g.id = s.game_id WHERE $__timeFilter(s.scanned_at) ORDER BY s.scanned_at DESC LIMIT 30",
