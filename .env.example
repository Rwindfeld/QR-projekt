DATABASE_URL=postgresql://postgres:1590@localhost:6432/QR
DIRECT_DATABASE_URL=postgresql://postgres:1590@localhost:5432/QR
# PERMANENT URL til trykte QR — skift ALDRIG efter print (fx https://qr-spilcafe.onrender.com)
BASE_URL=https://din-endelige-adresse.her

# Grafana Cloud Alloy — remote_write credentials
GRAFANA_ALLOY_TOKEN=glc_xxxxx_replace_me
# URL fra Grafana Cloud → Prometheus → "remote_write" (din stack har fx prod-65 i hostnavnet)
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-2.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=3222300
GRAFANA_CLOUD_STACK_REGION=prod-eu-west-2

# Render qr-db → Connections → External Database URL (til Grafana Postgres data source)
# RENDER_DATABASE_URL=postgresql://qr:password@dpg-xxxxx.frankfurt-postgres.render.com/qr
